# Auto detect text files and perform LF normalization
* text=auto
# Source code
*.c text
*.h text
*.cpp text
*.hpp text
# Scripts
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
# Documentation
*.md text
*.txt text
# Binaries
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.bin binary
*.lib binary
*.a binary
